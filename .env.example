# Hive reads this file (copy it to .env, which git ignores) for Pull latest, Dev stack, Deploy,
# the Dependabot watcher, Watch, the file-drop skills and the app name.
# Nothing workspace-specific lives in the code: repos, stacks, commands, ports and cloud names are all defined here.
# A feature whose keys are missing is simply off (its panel says so).
# Everything here can be edited in the app instead (Settings in the top bar); on first run Hive copies these keys
# (minus credentials) into ~/.claude/hive-settings.json and uses that from then on. Credentials stay in this file.

# Folder that contains your git repos (each repo is a direct child).
HIVE_REPOS_ROOT=C:\path\to\your\repos
# Folders inside the root whose children are also repos (comma list; any that exist are used).
HIVE_AGENTS_FOLDERS=agents
# Root-relative paths Pull latest skips (comma list). Folders starting with _ or . are always skipped.
HIVE_PULL_SKIP=some-repo/mirror
# Where Hive creates git worktrees for "Run from" a branch (relative to the root, or absolute).
HIVE_WORKTREES_DIR=.hive-worktrees

# Stacks: a button each. SERVICES lists service keys defined below.
HIVE_STACKS=app
HIVE_STACK_APP_LABEL=App stack
HIVE_STACK_APP_SERVICES=db,api,web

# Every service key used by any stack.
HIVE_SERVICES=db,api,web

# Docker service: Hive runs `docker compose up -d <COMPOSE>` in the repo folder (shared, always from the main checkout).
HIVE_SVC_DB_NAME=app-postgres
HIVE_SVC_DB_KIND=docker
HIVE_SVC_DB_REPO=my-api
HIVE_SVC_DB_COMPOSE=postgres
HIVE_SVC_DB_PORT=5432

# Process service: CMD runs in the repo folder (or in the worktree you pick under "Run from").
# {python} becomes PYTHON (a path relative to the main checkout), or plain `python` if that file is missing.
# ENV: defaults as KEY=VALUE;KEY=VALUE. The repo's own ENVFILE (default .env) is loaded on top of them.
HIVE_SVC_API_NAME=my-api
HIVE_SVC_API_REPO=my-api
HIVE_SVC_API_PYTHON=venv/Scripts/python.exe
HIVE_SVC_API_CMD="{python}" manage.py runserver 8000
HIVE_SVC_API_PORT=8000
HIVE_SVC_API_ENV=DATABASE_HOST=127.0.0.1;DATABASE_PORT=5432

# OPEN=true shows an Open link (http://localhost:PORT). ENVFILE= (empty) loads no env file.
HIVE_SVC_WEB_NAME=my-web
HIVE_SVC_WEB_REPO=my-web
HIVE_SVC_WEB_CMD=npm run dev
HIVE_SVC_WEB_PORT=5173
HIVE_SVC_WEB_OPEN=true
HIVE_SVC_WEB_ENVFILE=

# ---------- Deploy ----------
# Suites: a button each. API repos deploy (and are diffed) before web repos. Repos are folders under HIVE_REPOS_ROOT.
HIVE_DEPLOY_SUITES=app
HIVE_DEPLOY_SUITE_APP_LABEL=App
HIVE_DEPLOY_SUITE_APP_API=my-api
HIVE_DEPLOY_SUITE_APP_WEB=my-web
# GitHub org for the changelog's compare links, and the deploy script (run as `bash <script> staging|prod` in the repo).
HIVE_DEPLOY_ORG=my-org
HIVE_DEPLOY_SCRIPT=deploy-tools/deploy.sh
# diffs script run for the diff step as `bash diffs.sh <suite id>`; default is diffs.sh next to HIVE_DEPLOY_SCRIPT
# HIVE_DIFFS_SCRIPT=deploy-tools/diffs.sh
# Read-only landed check. API repo: ECS services; {env} is dev / qa / staging / prod. The first service is what "served" means.
HIVE_DEPLOY_REGION=us-east-1
HIVE_DEPLOY_API_REPO=my-api
HIVE_DEPLOY_API_CLUSTER={env}-my-cluster
HIVE_DEPLOY_API_SERVICES=api,worker
HIVE_DEPLOY_API_SERVICE_NAME={cluster}-{service}-service
# Web repo: S3 bucket (also the site host) and CloudFront distribution id, per env.
HIVE_DEPLOY_WEB_REPO=my-web
HIVE_DEPLOY_WEB_DEV=dev.example.com,EDISTRIBUTIONDEV
HIVE_DEPLOY_WEB_QA=qa.example.com,EDISTRIBUTIONQA
HIVE_DEPLOY_WEB_STAGING=staging.example.com,EDISTRIBUTIONSTG
HIVE_DEPLOY_WEB_PROD=example.com,EDISTRIBUTIONPROD

# ---------- Dependabot watcher ----------
# Once a day at TIME (local, HH:MM; at the next start if Hive was closed then), open Dependabot PRs in these repos get one
# background review thread each (new PRs, or ones Dependabot updated since their last review). Read-only on GitHub.
HIVE_DEPENDABOT_REPOS=my-org/my-api,my-org/my-web
HIVE_DEPENDABOT_TIME=12:00

# ---------- Watchers ----------
# Watchers are scheduled self-prompting background threads, one folder each under ~/.claude/hive/watchers/<id>/
# (watcher.json with the name, goal, on/off and schedule; the prompt file; memory/ with its SQLite db; reports/;
# findings.jsonl). Each owns ONE long-lived thread: every run is a new turn in it. Make and change them in the Watchers
# view or with the create_watcher / update_watcher tools any thread has; nothing here is needed.
# Upgrading from the single Watch: if HIVE_WATCH_DIR is set, that folder moves in once as watcher "watch" (memory, db,
# reports and findings kept) with its schedule taken from the keys below; after that these keys are not read.
# HIVE_WATCH_DIR=~/.claude/hive/watch
# HIVE_WATCH_EVERY=adaptive
# HIVE_WATCH_TIERS=50:1h,60:3h,70:6h,100:1d
# HIVE_WATCH_DAILY=08:00
# HIVE_WATCH_WEEKLY=Mon 08:00
# HIVE_WATCH_PROMPT=
# HIVE_WATCH_CWD=
# A watcher thread past this many tokens of context gets a fresh thread at its next run (its memory folder and db carry over).
# HIVE_WATCHER_ROTATE_CONTEXT=150000

# ---------- File drop ----------
# Drop a csv / xlsx / xls / pdf / json file on the window to start a background thread that runs one of your skills on it.
# "Title:skill-name" pairs, comma separated, one button each. Leave empty to turn it off.
HIVE_DROP_SKILLS=Import:my-import-skill,Summary:my-summary-skill

# ---------- Threads ----------
# A shell command still running after this many seconds moves to the background, so the thread stays free (0 = off).
# HIVE_AUTO_BACKGROUND_S=60
# A thread past this many tokens of context (or one that just compacted) offers a handoff to a fresh thread (0 = only on compaction).
# HIVE_HANDOFF_AT=200000
