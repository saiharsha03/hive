<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the phone: not to a cloud backup, not in a transfer to a new phone. The pairing is
     wrapped by Keystore keys that stay behind anyway, so a copy of these files could not be opened; a new phone is
     paired anew in Hive. (allowBackup="false" alone does not stop device-to-device transfer on Android 12 and up.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
