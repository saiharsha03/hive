{
  "name": "hive",
  "productName": "Hive",
  "version": "1.2.0",
  "private": true,
  "description": "One desk, many agents: a desktop orchestrator for Claude Code agents",
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "ai-agents",
    "agents",
    "electron",
    "react",
    "typescript",
    "desktop",
    "developer-tools"
  ],
  "homepage": "https://github.com/saiharsha03/hive#readme",
  "bugs": {
    "url": "https://github.com/saiharsha03/hive/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiharsha03/hive.git"
  },
  "license": "MIT",
  "author": "saiharsha03",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@fontsource-variable/inter": "^5.3.0",
    "@vue/language-server": "^2.2.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "minisearch": "^7.2.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pyright": "^1.1.414",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ts5": "npm:typescript@^5.9.3",
    "typescript-language-server": "^6.0.3",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.1",
    "typescript-for-lint": "npm:typescript@6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "ws": "^8.18.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
